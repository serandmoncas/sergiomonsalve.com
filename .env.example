# Supabase — get from https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Correos con acceso de administrador, separados por comas
ADMIN_EMAILS=tu-correo@example.com
# Nombre que se muestra del administrador
ADMIN_NAME=Tu Nombre

# Manual de Usuario: token fine-grained de solo lectura sobre serandmoncas/manual-de-usuario (solo Production)
MANUAL_GITHUB_TOKEN=github_pat_your_token

# Resend — get from https://resend.com/api-keys
RESEND_API_KEY=re_your_key

# App
NEXT_PUBLIC_SITE_URL=https://sergiomonsalve.com
CONTACT_EMAIL=serandmoncas@gmail.com
